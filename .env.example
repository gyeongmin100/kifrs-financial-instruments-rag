# Copy this file to .env and replace placeholders locally.
# Never commit the resulting .env file.
OPENAI_API_KEY=your_api_key
OPENAI_CHAT_MODEL=gpt-5.6-terra
OPENAI_RERANK_MODEL=gpt-5.6-terra
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password
NEO4J_DATABASE=neo4j

# Local-only semantic KG review console. Keep disabled on public deployments.
ENABLE_SEMANTIC_REVIEW=0
SEMANTIC_REVIEW_TOKEN=replace_with_a_long_random_token

# --- 배포 전용(선택). 로컬 실행 시 비워두면 기존과 동일하게 동작한다. ---
# 프론트엔드를 분리 배포할 때 허용할 origin 목록(쉼표 구분).
# CORS_ALLOW_ORIGINS=https://your-site.pages.dev
# IP당 시간당 /v1/ask 요청 제한. 0 또는 미설정이면 제한 없음.
# ASK_RATE_LIMIT_PER_HOUR=10
# 리버스 프록시(HF Spaces 등) 뒤에서 실행할 때만 1로 설정.
# TRUST_PROXY_HEADERS=1
