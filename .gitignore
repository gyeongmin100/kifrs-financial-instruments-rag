.env
.env.*
!.env.example

__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
logs/
*.log

# Project notes and generated visualizations stay local. README.md is the only
# repository document; the service UI HTML under src/ remains tracked.
/*.md
!/README.md
/*.html
/docs/*.md
/data/*.md

# Licensed K-IFRS source documents remain local, including files kept at project root.
*.hwp
*.hwpx
*.pdf

# Parsed text, chunks, embeddings, semantic KG exports, and validation artifacts
# are derived from the local source documents and are not part of the public code repo.
data/raw/**
data/processed/**
data/chunks/**
data/embeddings/**
data/semantic/**
data/semantic_candidates/**
data/validation/**

# Local Neo4j/Docker runtime state.
neo4j-data/
neo4j-logs/
neo4j-import/

# Generated deployment bundles.
deploy/
